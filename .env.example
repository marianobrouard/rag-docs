# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
# Check current names at https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Optional tuning (defaults are in src/rag_docs/config.py)
# REQUEST_TIMEOUT_S=60
# MAX_OUTPUT_TOKENS=500
# LLM_MAX_RETRIES=6

# LangSmith: needed for `rag_docs.evaluate`; tracing of single questions needs TRACING=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-docs
